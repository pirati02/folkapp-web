# Copy to .env for local development (`npm run dev`). In production, set these on the host.

PORT=8080
# Public origin of this API; song and image links are built from it.
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:4200
# The web app; shared song links open the song there.
WEB_BASE_URL=http://localhost:4200

# Postgres with the FolkApp schema (see db/schema.sql). Hosted providers usually need ?sslmode=require.
DATABASE_URL=postgres://admin:adminpass@localhost:5434/FolkAppDatabase

# Google Drive folders holding the songs and holiday images (the id is the last part of the folder URL).
# Both must be shared with the service account's email as Viewer.
GDRIVE_AUDIO_FOLDER_ID=
GDRIVE_IMAGE_FOLDER_ID=
# Service-account key: a path to the JSON file (local), or the JSON itself (Render).
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json
# GOOGLE_SERVICE_ACCOUNT_KEY=

# Optional: shorten shared song links with TinyURL.
# TINYURL_TOKEN=
